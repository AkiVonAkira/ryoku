<?xml version="1.0" encoding="utf-8"?>

<!-- Fedora's LiveInstall and BootCoreLive profiles (releng/kiwi-descriptions, f44),
     cut down to a console live system that runs the Ryoku installer. -->
<image schemaversion="7.4" name="Ryoku-Fedora" displayname="Ryoku Fedora">
	<description type="system">
		<author>Ryoku</author>
		<contact>https://github.com/ryoku-dev/ryoku</contact>
		<specification>Ryoku installer live image on Fedora Linux</specification>
	</description>
	<preferences>
		<version>44.0.0</version>
		<packagemanager>dnf5</packagemanager>
		<rpm-check-signatures>true</rpm-check-signatures>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>UTC</timezone>
		<release-version>44</release-version>
		<type image="iso"
			publisher="Ryoku" volid="Ryoku_Fedora" application_id="Ryoku_Fedora"
			primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6"
			firmware="uefi" efiparttable="gpt" efifatimagesize="30" kernelcmdline="quiet"
			fscreateoptions="-Efragments -C 1048576"
			>
			<bootloader name="grub2" console="console" timeout="5"/>
		</type>
	</preferences>
	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<packages type="bootstrap">
		<package name="filesystem"/>
		<package name="fedora-release"/>
		<package name="grubby"/>
	</packages>
	<packages type="image" patternType="plusRecommended">
		<namedCollection name="core"/>
		<ignore name="kernel-*debug*"/>
		<package name="glibc-all-langpacks"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="linux-firmware"/>
		<package name="amd-ucode-firmware"/>
		<package name="microcode_ctl"/>
		<package name="dracut-live"/>
		<package name="grub2-efi-x64"/>
		<package name="grub2-efi-x64-modules"/>
		<package name="grub2-pc"/>
		<package name="grub2-pc-modules"/>
		<package name="shim-x64"/>
		<package name="efibootmgr"/>

		<package name="parted"/>
		<package name="gdisk"/>
		<package name="btrfs-progs"/>
		<package name="dosfstools"/>
		<package name="e2fsprogs"/>
		<package name="cryptsetup"/>
		<package name="ntfs-3g"/>
		<package name="ntfsprogs"/>
		<package name="lvm2"/>
		<package name="mdadm"/>

		<package name="NetworkManager"/>
		<package name="NetworkManager-wifi"/>
		<package name="iwd"/>
		<package name="wireless-regdb"/>

		<package name="cage"/>
		<package name="foot"/>
		<package name="kbd"/>
		<!-- the JetBrains Mono Nerd Font the installer session asks foot for, and the Bibata cursors -->
		<package name="ryoku-extras"/>

		<package name="bash"/>
		<package name="curl"/>
		<package name="git"/>
		<package name="jq"/>
		<package name="sudo"/>
		<package name="less"/>
		<package name="vim-minimal"/>
		<package name="openssl"/>
		<package name="pciutils"/>
		<package name="dnf5"/>
		<package name="rpm"/>
	</packages>
	<packages type="iso">
		<package name="grub2-efi-x64-cdboot"/>
	</packages>
</image>
