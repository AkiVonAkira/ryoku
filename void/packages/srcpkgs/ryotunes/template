# Template file for 'ryotunes'
pkgname=ryotunes
version=1.1.6
revision=1
_upstream_pkgrel=1
archs="x86_64"
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk+3-devel libwebkit2gtk41-devel mpv-devel openssl-devel"
depends="desktop-file-utils ffmpeg6 gtk+3 hicolor-icon-theme libwebkit2gtk41
 librsvg mpv openssl polkit quickshell xdg-utils yt-dlp"
short_desc="Ryoku music client, playback daemon, and sync server"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://github.com/Ryoku-dev/ryotunes"
distfiles="${homepage}/releases/download/v${version}/ryotunes-${version}.tar.gz"
checksum=9ecadc6d9b8f0ac151a6d0505b0f3323cd8c46bf467f06e90c359f3a69860982
nocross=yes

# The source release tracks the same stable tag selected by Arch's importer.
# Bump version, _upstream_pkgrel, and checksum together from releases/latest.
# Linux uses this binary to ask ryotunesd to open the installed QML client; it never runs Tauri.
# Building without default features avoids bundling the unused web frontend.
do_build() {
	cargo build --release --locked --target "${RUST_TARGET}" \
		--package ryotunes --bin ryotunes --no-default-features
	cargo build --release --locked --target "${RUST_TARGET}" \
		--package sync-server --package ryotunesd --package ryotunes-cli
}

do_install() {
	local binaries="target/${RUST_TARGET}/release"

	vbin "${binaries}/ryotunes"
	vbin "${binaries}/ryotunes-sync"
	vbin "${binaries}/ryotunesd"
	vbin "${binaries}/ryotunes-cli"
	vbin packaging/linux/ryotunes-qml
	vbin "${FILESDIR}/ryotunes-diagnostics"

	vmkdir usr/share/ryotunes
	vcopy client usr/share/ryotunes
	rm -rf "${DESTDIR}/usr/share/ryotunes/client/tests"
	vcopy skins usr/share/ryotunes
	vinstall matugen/ryotunes.json 644 usr/share/ryotunes/matugen

	vinstall packaging/linux/ryotunes.desktop 644 usr/share/applications
	vinstall packaging/linux/dev.ryoku.ryotunes.metainfo.xml 644 usr/share/metainfo
	vinstall src-tauri/icons/32x32.png 644 usr/share/icons/hicolor/32x32/apps ryotunes.png
	vinstall src-tauri/icons/64x64.png 644 usr/share/icons/hicolor/64x64/apps ryotunes.png
	vinstall src-tauri/icons/128x128.png 644 usr/share/icons/hicolor/128x128/apps ryotunes.png
	vinstall src-tauri/icons/128x128@2x.png 644 usr/share/icons/hicolor/256x256/apps ryotunes.png
	vinstall src-tauri/icons/icon.png 644 usr/share/icons/hicolor/512x512/apps ryotunes.png

	vlicense LICENSE
	vdoc README.md
	vdoc UPSTREAM.md
}
