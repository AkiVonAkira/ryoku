#!/usr/bin/env bash

# Official-repository install through the host package seam. Bundle manifests
# keep using Ryoku's Arch-side catalogue names; ryoku-host translates them for
# the active package manager. Needs a TTY for the sudo prompt, which is why the
# Hub runs installs in a floating terminal.

set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-add: no packages given" >&2
  exit 2
}

# Every manager installs through the host seam. Pacman asks for its full-sync
# transaction so installing against stale databases cannot create a partial
# upgrade. `--needed` is pacman spelling; the host seam already skips packages
# that are present.
packages=()
for arg in "$@"; do
  [[ $arg == --needed ]] || packages+=("$arg")
done
((${#packages[@]})) || exit 0
upgrade=()
[[ $(ryoku-host pkgmgr 2>/dev/null || true) == pacman ]] && upgrade=(--upgrade)
exec sudo ryoku-host pkg install "${upgrade[@]}" "${packages[@]}"
