#!/usr/bin/env bash

# Official-repository install through the host package seam. Bundle manifests
# keep using Ryoku's Arch-side catalogue names; ryoku-host translates them for
# the active package manager. Needs a TTY for the sudo prompt, which is why the
# Hub runs installs in a floating terminal.

set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-add: no packages given" >&2
  exit 2
}

# Pacman keeps its full-sync transaction so installing against stale databases
# cannot create a partial upgrade. Other managers install translated catalogue
# packages through the host seam. `--needed` is pacman spelling; the native
# host implementations already skip packages that are present.
manager=$(ryoku-host pkgmgr 2>/dev/null || true)
if [[ -n $manager && $manager != pacman ]]; then
  packages=()
  for arg in "$@"; do
    [[ $arg == --needed ]] || packages+=("$arg")
  done
  ((${#packages[@]})) || exit 0
  exec sudo ryoku-host pkg install "${packages[@]}"
fi
exec sudo pacman -Syu --needed --noconfirm "$@"
